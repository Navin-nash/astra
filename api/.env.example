# Server
PORT=8080
ENVIRONMENT=development

# Database (same Postgres instance as Next.js / Better Auth)
DATABASE_URL=postgres://astra:astra_dev@localhost:5432/astra

# Redis
REDIS_URL=redis://localhost:6379

# JWT secret — MUST match JWT_SECRET in web/.env.local
# Generate: openssl rand -hex 32
JWT_SECRET=change_me_to_a_64_char_hex_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# AI provider — Groq by default (OpenAI-compatible)
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_...

# Model name (Groq models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
OPENAI_MODEL=llama-3.3-70b-versatile

# Override to use a different OpenAI-compatible provider
# Default: https://api.groq.com/openai/v1
# Anthropic: https://api.anthropic.com/v1  (with model: claude-sonnet-4-6)
# OpenAI:    https://api.openai.com/v1     (with model: gpt-4o-mini)
# Ollama:    http://localhost:11434/v1      (with model: llama3.2)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
