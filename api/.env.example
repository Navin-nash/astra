# Server
PORT=8080
ENVIRONMENT=development

# Database (same Postgres instance as Next.js / Better Auth)
DATABASE_URL=postgres://astra:astra_dev@localhost:5432/astra

# Redis
REDIS_URL=redis://localhost:6379

# JWT secret — MUST match JWT_SECRET in web/.env.local
# Generate: openssl rand -hex 32
JWT_SECRET=change_me_to_a_64_char_hex_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ── AI providers ──────────────────────────────────────────────────────────────
#
# Provider routing order (to minimise 429s given rate limits):
#   1. NVIDIA NIM  — 40 RPM, no daily cap  → PRIMARY
#   2. Groq        — 30 RPM, 12K TPM, 1K RPD → SECONDARY
#   3. OpenRouter  — 1K RPD (free tier)     → LAST RESORT (preserves daily budget)
#
# All three keys are required at startup.

# Primary: NVIDIA NIM (https://build.nvidia.com → get API key)
NVIDIA_NIM_API_KEY=nvapi-...
# Base URL (default, can be overridden)
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Secondary: Groq (https://console.groq.com)
GROQ_API_KEY=gsk_...
# Base URL for Groq (default, can be overridden)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Last resort: OpenRouter free tier (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-...
# Base URL for OpenRouter (OpenAI-compatible endpoint)
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Primary AI — Gemini (choose one auth method)
#
# Option A: Google ADC (OAuth2 — preferred, no quota limits tied to a key)
# Run `gcloud auth application-default login` and copy the values from
# ~/.config/gcloud/application_default_credentials.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
#
# Option B: API key fallback (AI Studio — used when ADC vars are absent)
GOOGLE_API_KEY=your_google_api_key_here
# Optional — override the Gemini endpoint (defaults to AI Studio OpenAI-compat)
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ── Model chains (informational — configured in source) ───────────────────────
# NVIDIA NIM (primary, 40 RPM):
#   nvidia/nemotron-3-ultra-550b-a55b, moonshotai/kimi-k2.6,
#   z-ai/glm-5.1, deepseek-ai/deepseek-v4-flash,
#   qwen/qwen3-next-80b-a3b-instruct, mistralai/mistral-nemotron
#
# Groq (secondary, 30 RPM / 12K TPM):
#   llama-3.3-70b-versatile
#
# OpenRouter (last resort, 1K RPD):
#   moonshotai/kimi-k2.6:free, nvidia/nemotron-3-ultra-550b-a55b:free,
#   nvidia/nemotron-3-super-120b-a12b:free, z-ai/glm-4.5-air:free,
#   qwen/qwen3-coder:free, meta-llama/llama-3.3-70b-instruct:free
